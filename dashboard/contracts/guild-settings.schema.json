{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Tree Guild Settings",
  "type": "object",
  "required": ["guildId", "trustedAdminRoleIds", "automod", "moderation", "featureToggles"],
  "properties": {
    "guildId": { "type": "string" },
    "modLogChannelId": { "type": ["string", "null"] },
    "musicPanel": {
      "type": ["object", "null"],
      "properties": {
        "channelId": { "type": "string" },
        "messageId": { "type": "string" }
      },
      "required": ["channelId", "messageId"]
    },
    "trustedAdminRoleIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "automod": { "$ref": "./automod-settings.schema.json" },
    "moderation": {
      "type": "object",
      "properties": {
        "requireReason": { "type": "boolean" },
        "caseLogEnabled": { "type": "boolean" }
      },
      "required": ["requireReason", "caseLogEnabled"]
    },
    "featureToggles": {
      "type": "object",
      "properties": {
        "moderation": { "type": "boolean" },
        "automod": { "type": "boolean" },
        "utility": { "type": "boolean" }
      },
      "required": ["moderation", "automod", "utility"]
    },
    "activityRoles": {
      "type": "object",
      "properties": {
        "spotify": { "$ref": "#/$defs/activityRole" },
        "streaming": { "$ref": "#/$defs/activityRole" },
        "gaming": { "$ref": "#/$defs/activityRole" },
        "voice": { "$ref": "#/$defs/activityRole" }
      },
      "required": ["spotify", "streaming", "gaming", "voice"]
    }
  },
  "$defs": {
    "activityRole": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "roleId": { "type": ["string", "null"] }
      },
      "required": ["enabled", "roleId"]
    }
  }
}
